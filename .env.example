# ============================================================
# heatmap-forge configuration
# Copy this file to .env and fill in your values.
# The tool reads .env at startup; every key below is optional
# unless marked (required).
# ============================================================

# GitHub access token (required). Scopes needed: 'repo' (classic token)
# or a fine-grained token with Contents: Read & Write on the target repo.
# Leave empty and it will also read the GITHUB_TOKEN env var.
GITHUB_TOKEN=ghp_yourTokenHere

# Target repo in "owner/repo" format (required). Must already exist on GitHub.
REPO=yourusername/yourrepo

# Commit date range, YYYY-MM-DD. Both can be in the past (required).
START_DATE=2024-01-01
END_DATE=2024-12-31

# Branch to commit on. 'main'/'master' auto-detect the repo's default branch.
BRANCH=main

# Random range of commits per active day (both >= 1, min <= max).
COMMITS_PER_DAY_MIN=1
COMMITS_PER_DAY_MAX=3

# Commit frequency pattern. One of:
#   dense      - commit every day (solid heatmap) [default]
#   sparse     - commit on ~65% of days only
#   weekday    - commit on weekdays only, no weekends
#   realistic  - heavy weekdays, light weekends, occasional skips
SCHEDULE=dense

# Identity stamped on every commit (required). Use an email tied to your
# GitHub account so the squares count toward your heatmap.
AUTHOR_NAME=Your Name
AUTHOR_EMAIL=you@example.com
